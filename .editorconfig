# https://editorconfig.org — keeps whitespace consistent across IDEs so that a
# diff shows intent rather than someone else's formatter.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json}]
# YAML forbids tabs outright, and 2-space is the convention every Kubernetes and
# CloudFormation example uses. Matching it keeps these files diffable against
# upstream samples.
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, so trimming them
# would reflow paragraphs with no warning.
trim_trailing_whitespace = false

[*.{sql,xml}]
indent_size = 4

[Makefile]
indent_style = tab
