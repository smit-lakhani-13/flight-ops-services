<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      A standalone build: no <parent>, and the root pom.xml has no <modules>.
      A Spring Boot parent would bring framework dependency management and
      plugins into a function whose reason to exist is not paying for framework
      start-up. An aggregator root would also break ../Dockerfile, which builds
      one pom. The cost is that every version below is pinned by hand.

      The shaded jar is 10.3 MiB. I have not measured a cold start for it;
      published figures put a plain SDK handler at 1-2s and Spring Boot on
      Lambda at 3-6s.

          mvn -f lambda/pom.xml clean package    # -> lambda/target/booking-event-handler.jar
    -->

    <groupId>com.smit</groupId>
    <artifactId>booking-event-handler</artifactId>
    <version>1.3.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>booking-event-handler</name>
    <description>SQS-triggered Lambda that projects booking events into DynamoDB</description>
    <url>https://github.com/smit-lakhani-13/flight-ops-services</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          `release`, not source/target: it compiles against the Java 21 API, so a
          call to a newer method fails the build instead of throwing
          NoSuchMethodError inside Lambda. It must match `Runtime: java21` in
          template.yaml, and the two move together. I kept 21 when Lambda
          added java25, so both modules build with one JDK.
        -->
        <maven.compiler.release>21</maven.compiler.release>

        <aws.lambda.core.version>1.4.0</aws.lambda.core.version>
        <aws.lambda.events.version>3.16.1</aws.lambda.events.version>
        <aws.lambda.tests.version>1.1.2</aws.lambda.tests.version>

        <!-- Same pin as ../pom.xml. Keep the two in step. -->
        <aws.sdk.version>2.55.2</aws.sdk.version>

        <!--
          Pinned because the AWS SDK BOM does not manage jackson-databind. The
          producer writes the event with Jackson 3 (Boot 4's tools.jackson) and
          this consumer reads it with Jackson 2, so the two sides do not share a
          serialiser. That is why contracts/booking-created-v1.json is tested from
          both sides. Kept at the version of <jackson-2-bom.version> in ../pom.xml,
          so the repository has one Jackson 2 to patch.
        -->
        <jackson.version>2.22.2</jackson.version>

        <!-- The service's JUnit major, so both suites share assertions and output. -->
        <junit.version>6.0.3</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <assertj.version>3.27.7</assertj.version>

        <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
        <cyclonedx.plugin.version>2.9.3</cyclonedx.plugin.version>
        <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Aligns every software.amazon.awssdk:* artifact to one version. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Context, RequestHandler, LambdaLogger. -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-core</artifactId>
            <version>${aws.lambda.core.version}</version>
        </dependency>

        <!--
          SQSEvent and SQSBatchResponse. It brings joda-time 2.10.8 (644 KB,
          247 classes). Do not exclude it: SQSEvent does not use Joda, but
          LambdaEventSerializers registers a Joda module for the whole event
          model, and EventLoader then fails with
            ClassNotFoundException: org.joda.time.DateTime
          The three EventLoader tests in BookingEventHandlerTest catch that.
          Re-adding it at test scope would make them pass on a classpath the
          shaded jar does not have.
        -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-events</artifactId>
            <version>${aws.lambda.events.version}</version>
        </dependency>

        <!--
          The low-level client, not dynamodb-enhanced. The enhanced client builds
          its TableSchema by reflection at start-up, which is cold-start time
          spent on a handler that writes six attributes by hand.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>

            <!--
              The SDK brings two HTTP clients transitively: netty-nio-client
              (async) and apache5-client (sync). Declaring url-connection-client
              does not displace them, and with two sync clients present the SDK
              picks by its own priority list, which puts Apache 5 first. Left in,
              they take the jar from 10.3 MiB to 16.6 MiB (2,509 io.netty and
              1,433 Apache HttpClient 5 classes) for one synchronous PutItem.

              apache-client (httpclient 4.x) is not transitive at 2.55.x. Its
              exclusion stays so an SDK bump that re-adds it cannot slip in.
              Excluding the async client is safe only while the handler uses the
              synchronous DynamoDbClient: DynamoDbAsyncClient would fail at init
              with "Unable to load an HTTP implementation".
            -->
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
          The one HTTP client left. It wraps java.net.HttpURLConnection, so it is
          34 KB and pulls in nothing, where apache5-client brings about 1,400
          classes to load on every cold start. It gives up HTTP/2, a tunable pool
          and async, none of which one call per message needs. The service in
          ../pom.xml has steady traffic and keeps the SDK's default, Apache 5.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Test scope only from here down. -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- EventLoader: reads the SQS event files in events/ the way Lambda would. -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-tests</artifactId>
            <version>${aws.lambda.tests.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- No version suffix, so template.yaml and the deploy commands never change. -->
        <finalName>booking-event-handler</finalName>

        <!--
          events/ is on the test classpath, so the tests and, from the root,
          `sam local invoke -t lambda/template.yaml -e lambda/events/sqs.json`
          read the same fixture files.
          Declaring <testResources> replaces the default, which is why
          src/test/resources is listed again.
        -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>events</directory>
            </testResource>
        </testResources>

        <plugins>
            <!--
              With no parent, this is the only JDK check, and it fails at validate
              with a sentence about the JDK. requireUpperBoundDeps matters more here
              than in the service: this module imports two BOMs by hand, and shade
              flattens whatever they resolve to into one jar.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>This build needs JDK 21. Point JAVA_HOME at a JDK 21 (Homebrew on macOS: export JAVA_HOME=/opt/homebrew/opt/openjdk@21).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                    <message>Use ./mvnw -f lambda/pom.xml, which pins the wrapper to a known Maven version.</message>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Shade inlines every dependency, so the shaded jar has no
              dependency list of its own; this SBOM is that list. There is no
              JaCoCo gate: the module is one class, and its tests target the
              behaviours that can go wrong. scripts/numbers.sh prints the count.
            -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.plugin.version}</version>
                <executions>
                    <execution>
                        <id>build-sbom</id>
                        <phase>package</phase>
                        <goals><goal>makeBom</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <outputFormat>json</outputFormat>
                    <outputName>bom</outputName>
                    <includeTestScope>false</includeTestScope>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <!--
                      A fixed non-UTC zone. CI runs in UTC, where a sort-key
                      formatter that used the system zone would still pass;
                      at +05:30 it fails.
                    -->
                    <argLine>-Duser.timezone=Asia/Kolkata</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Nothing depends on this artifact, so a rewritten pom would only confuse. -->
                    <createDependencyReducedPom>false</createDependencyReducedPom>

                    <transformers>
                        <!--
                          Concatenates META-INF/services files that share a path
                          instead of keeping the last one, which would drop a
                          provider with no build error.
                        -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                        <!-- The same for the SDK's global execution-interceptor list. -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>software/amazon/awssdk/global/handlers/execution.interceptors</resource>
                        </transformer>
                    </transformers>

                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <!--
                                  Repackaging breaks the signatures of signed jars,
                                  and the JVM then refuses the classes with
                                  "Invalid signature file digest".
                                -->
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>

                                <!--
                                  An uber-jar is not a valid JPMS module, and Lambda
                                  runs it on the classpath.
                                -->
                                <exclude>module-info.class</exclude>
                                <exclude>META-INF/versions/*/module-info.class</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
