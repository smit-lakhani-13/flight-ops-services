{
  "name": "flight-ops-console",
  "version": "0.1.0",
  "private": true,
  "description": "A browser console for flight-ops-service that reaches the API through a same-origin proxy.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
