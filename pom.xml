<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.smit</groupId>
    <artifactId>flight-ops-service</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>flight-ops-service</name>
    <description>
        Flight inventory and booking microservice. REST API over PostgreSQL with
        optimistic and pessimistic locking plus request idempotency on the seat
        reservation path, publishing booking events to SQS for a Lambda consumer
        to project into DynamoDB.
    </description>
    <url>https://github.com/smit-lakhani-13/flight-ops-services</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>smit-lakhani-13</id>
            <name>Smit Lakhani</name>
            <url>https://github.com/smit-lakhani-13</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/smit-lakhani-13/flight-ops-services</url>
        <connection>scm:git:https://github.com/smit-lakhani-13/flight-ops-services.git</connection>
        <developerConnection>scm:git:git@github.com:smit-lakhani-13/flight-ops-services.git</developerConnection>
    </scm>

    <properties>
        <java.version>21</java.version>
        <!--
          Spring Boot's BOM does not manage the AWS SDK, so this pin is the only
          thing controlling it. That makes it easy to forget and drift years
          behind, which is a supply-chain problem as much as a features one.
        -->
        <aws.sdk.version>2.55.0</aws.sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Registers /actuator/prometheus. The actuator starter alone does NOT:
          `management.endpoints.web.exposure.include` can name the endpoint and
          Spring will silently not create it if no registry is on the classpath,
          so the config reads as if scraping works and the endpoint 404s. Needed
          because the HPA scales on CPU from metrics-server today but any real
          deployment scales on application metrics, and those come from here.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema is owned by Flyway on PostgreSQL; Hibernate only validates it. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Publishes booking-created events consumed by the Lambda in lambda/. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
