<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.smit</groupId>
    <artifactId>flight-ops-service</artifactId>
    <version>1.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>flight-ops-service</name>
    <description>
        Flight inventory and booking service. REST API over PostgreSQL with
        optimistic and pessimistic locking plus request idempotency on the seat
        reservation path, publishing booking events to SQS for a Lambda consumer
        to project into DynamoDB.
    </description>
    <url>https://github.com/smit-lakhani-13/flight-ops-services</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>smit-lakhani-13</id>
            <name>Smit Lakhani</name>
            <url>https://github.com/smit-lakhani-13</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/smit-lakhani-13/flight-ops-services</url>
        <connection>scm:git:https://github.com/smit-lakhani-13/flight-ops-services.git</connection>
        <developerConnection>scm:git:git@github.com:smit-lakhani-13/flight-ops-services.git</developerConnection>
    </scm>

    <properties>
        <java.version>21</java.version>
        <!-- Boot's BOM does not manage the AWS SDK, so this pin is the only thing controlling it. -->
        <aws.sdk.version>2.55.2</aws.sdk.version>

        <!--
          Not in Boot's BOM either. springdoc 3.x targets Boot 4.x; 3.1.1 is the
          first release built against 4.1.
        -->
        <springdoc.version>3.1.1</springdoc.version>

        <!--
          Jackson 2 only, for swagger-core (springdoc), which needs 2.22.1 while Boot
          manages Jackson 2 at 2.21.5; requireUpperBoundDeps refuses the older one. The
          service serialises with Jackson 3 on Boot's version. The Lambda reads the event
          with Jackson 2 (<jackson.version> in lambda/pom.xml), so the two sides do not
          share a serialiser, which is why contracts/booking-created-v1.json is tested
          from both. Keep the two pins in step; 2.22.1 is the floor.
        -->
        <jackson-2-bom.version>2.22.2</jackson-2-bom.version>

        <!--
          JaCoCo is pinned for a reproducible build, because Boot's parent does not
          manage it. Boot's parent does manage the enforcer and CycloneDX; these two
          pins override its versions, so a Boot upgrade does not move them.
        -->
        <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
        <jacoco.plugin.version>0.8.15</jacoco.plugin.version>
        <cyclonedx.plugin.version>2.9.3</cyclonedx.plugin.version>

        <!--
          archunit-junit6, not archunit-junit5: the junit5 artifact binds to JUnit
          Platform 1.x and fails at discovery with a NoSuchMethodError on Boot 4.1's Platform 6.
        -->
        <archunit.version>1.5.0</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- spring-boot-starter-webmvc: Boot 4 deprecates spring-boot-starter-web in its favour. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          HTTP Basic for the operations endpoints, and JWT verification for machine
          callers, active only when an issuer is configured (see SecurityConfig).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!--
          Registers /actuator/prometheus. The actuator starter alone does not: the
          exposure list can name the endpoint and it still 404s without a registry.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Tracing: a traceId and spanId on every log line. Spans are exported only once
          management.opentelemetry.tracing.export.otlp.endpoint is set. The starter also
          brings a push OTLP metrics registry, which application.yml turns off because
          Prometheus scrapes this service.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!--
          OpenAPI 3.1 plus the Swagger UI. SecurityConfig permits both paths
          anonymously; every operation they describe still answers 401 without credentials.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
          Flyway owns the PostgreSQL schema; Hibernate only validates it. The starter
          carries FlywayAutoConfiguration. Flyway ships each database as its own module,
          so PostgreSQL needs flyway-database-postgresql.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Publishes booking-created events consumed by the Lambda in lambda/. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>
        <!--
          IRSA. DefaultCredentialsProvider swaps the pod's web identity token
          for credentials with code it loads from this module by reflection.
          Without it that step fails and the chain moves on, so SQS sends never
          get the pod's role. No main code imports it, hence runtime scope;
          AwsConfigTest fails if it goes.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Boot 4 moved @WebMvcTest and @DataJpaTest (with TestEntityManager) into these
          two starters; without them the slice tests do not compile.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x publishes each module with a testcontainers- prefix; the 1.x artifact ids have no 2.x release. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit6</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              build-info writes META-INF/build-info.properties. Without it /actuator/info
              returns {} and the OpenAPI document falls back to a hard-coded version.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              The toolchain gate: a JDK 17 build of this tree would otherwise stop in the
              compiler on "release version 21 not supported"; this names the JDK to use
              and how to set it. requireUpperBoundDeps flags a dependency resolved below
              what something in the tree asked for; the stricter dependencyConvergence
              would flag dozens of versions the BOMs already settle.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>This build needs JDK 21. Point JAVA_HOME at a JDK 21 (with Homebrew on macOS: export JAVA_HOME=/opt/homebrew/opt/openjdk@21).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                    <message>Use ./mvnw, which pins the wrapper to a known Maven version.</message>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Coverage. prepare-agent sets the argLine property; the Surefire plugin below
              keeps it with @{argLine}.

              The thresholds sit below the measured coverage with room. With no Docker, nine
              tests skip (five in BookingIntegrationTest, three in OutboxPrunePostgresTest,
              one in LockTimeoutPostgresTest), and the bundle measures about 0.92 line and 0.75
              branch. CI runs the Testcontainers tests, so it can only measure higher.

              BUNDLE, because a per-class rule fails the build over an unused constructor on
              an exception class. The one exclusion is the main() class, which every
              @SpringBootTest already starts.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <configuration>
                    <excludes>
                        <exclude>com/smit/flightops/FlightOpsServiceApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.50</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              The test JVM runs in Asia/Kolkata, not UTC, so a formatter that uses the
              host zone fails BookingEventContractTest on a UTC CI runner too.
              @{argLine} keeps the JaCoCo agent that prepare-agent adds.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Duser.timezone=Asia/Kolkata</argLine>
                </configuration>
            </plugin>

            <!--
              A CycloneDX software bill of materials, target/bom.json, so the versions in
              the shipped artefact have a written answer. Test scope is not in the artefact.
            -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.plugin.version}</version>
                <executions>
                    <execution>
                        <id>build-sbom</id>
                        <phase>package</phase>
                        <goals><goal>makeBom</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <outputFormat>json</outputFormat>
                    <outputName>bom</outputName>
                    <includeTestScope>false</includeTestScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
