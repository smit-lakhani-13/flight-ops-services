# Keeps the build context small and secrets out of the image. BuildKit loads
# only the paths the Dockerfile copies, but a careless COPY could pick up any
# file left in the context.

# Build output. Stage 1 builds its own jar, and nothing COPYs a host-built one.
target/

# The build stage's base image pins Maven, so the wrapper would only download
# a second copy of the same version.
.mvn/
mvnw
mvnw.cmd

# VCS and IDE
.git/
.gitignore
.gitattributes
.editorconfig
.idea/
*.iml
.vscode/
.DS_Store

# Docs and infrastructure: not needed to run the app. `**/*.md`, because a
# bare `*.md` matches only the root of the context.
**/*.md
k8s/
deploy/
cluster.yaml
template.yaml
.github/
lambda/
events/
# The build recipe itself is not an input to the build.
Dockerfile
.dockerignore

# Anything that could carry credentials
.env
.env.*
*.pem
*.key
**/secret.yaml
