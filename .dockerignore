# Keeps the build context small and secrets out of the image. Every file in
# the context is sent to the daemon and could be picked up by a careless COPY.

# Build output. Stage 1 builds its own jar, and nothing COPYs a host-built one.
target/

# The build stage's base image pins Maven, so the wrapper would only download
# a second copy of the same version.
.mvn/
mvnw
mvnw.cmd

# VCS and IDE
.git/
.gitignore
.gitattributes
.editorconfig
.idea/
*.iml
.vscode/
.DS_Store

# Docs and infrastructure: not needed to run the app
*.md
k8s/
cluster.yaml
template.yaml
.github/
lambda/
events/
# The build recipe itself is not an input to the build.
Dockerfile
.dockerignore

# Anything that could carry credentials
.env
.env.*
*.pem
*.key
**/secret.yaml
