# Keeps the build context small and secrets out of the image. BuildKit loads
# only the paths the Dockerfile copies, but a careless COPY could pick up any
# file left in the context.

# Build output. Stage 1 builds its own jar, and nothing COPYs a host-built one.
target/

# The build stage's base image pins Maven, so the wrapper would only download
# a second copy of the same version.
.mvn/
mvnw
mvnw.cmd

# VCS and IDE
.git/
.gitignore
.gitattributes
.editorconfig
.idea/
*.iml
.vscode/
.DS_Store

# Docs, infrastructure, scripts and contract fixtures: not needed to build or
# run the app. `**/*.md`, because a bare `*.md` matches only the root of the
# context.
**/*.md
deploy/
scripts/
contracts/
.github/
lambda/
# The build recipe itself is not an input to the build.
Dockerfile
.dockerignore

# Anything that could carry credentials. certs/rds-global-bundle.pem holds
# public CA certificates, and the runtime stage copies it. A bare `*.pem`
# matches only the root, so it is not excluded today; the exception keeps it
# in if the rule is ever widened to `**/*.pem`.
.env
.env.*
*.pem
!certs/rds-global-bundle.pem
*.key
**/secret.yaml
